# Committed on purpose: Lovable builds (preview and live) read these from the repo.
#
# Both values are PUBLIC by design. They end up in every visitor's browser anyway;
# access to the data is enforced by Supabase sign-in plus the row-level security
# policies in supabase/migrations/. src/test/env-files.test.ts fails if anything
# else is added to this file.
#
# NEVER put SUPABASE_SECRET_KEY (sb_secret_...) or a service_role key here or anywhere
# in this repo. Nothing in the app needs it, and every VITE_ variable ships to browsers.
# To override locally, use .env.local (git-ignored).
VITE_SUPABASE_URL=https://lccbejcnadbznhztjqxa.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Zj4OEl7VqUae7K0hL2hMuw_zxjdJx7x
