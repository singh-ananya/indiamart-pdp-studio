# Copy to .env.local for local development. .env.local is git-ignored.
#
# Only these two values are used, and both end up in the browser bundle by design:
# the publishable key is public, and access is enforced by Supabase sign-in plus the
# row-level security policies in supabase/migrations/.
VITE_SUPABASE_URL=https://lccbejcnadbznhztjqxa.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Do NOT add SUPABASE_SECRET_KEY (or the legacy service_role key) here or anywhere in
# this app. Nothing in the studio needs it, and any VITE_ variable is shipped to browsers.
